# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Session pooler connection string (URL-encode special chars in the password)
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Resend ───────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=CVC HOA Portal <onboarding@resend.dev>

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── One-time sys_admin bootstrap (npm run db:seed-admin) ────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin
